---
// Decoration removed for simplicity


const title = 'Oven to Air Fryer Converter';
const subtitle =
	'Instantly convert oven cooking temperatures and cooking times into air fryer equivalents — with transparent formulas, presets, charts, and printable guides.';
---

<section class="bg-canvas-soft">
  <div class="mx-auto max-w-7xl px-6 pt-10 pb-10 md:pt-14 md:pb-12">
    <div class="grid gap-10 md:grid-cols-12 md:items-start">
      <div class="md:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full bg-link-bg-soft px-3 py-1.5 text-xs font-semibold text-body">
          <span class="inline-flex h-2 w-2 rounded-full bg-link" aria-hidden="true"></span>
          Instant temperature + time conversion
        </div>

	<h1 class="mt-5 font-display text-display-xl tracking-[-2.4px] text-ink">
          Oven to Air Fryer Conversion Calculator
          <span class="sr-only">Air Fryer Converter</span>
        </h1>

        <p class="mt-5 max-w-xl text-base text-body leading-7">
          {subtitle}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#calculator"
            class="inline-flex items-center justify-center rounded-[100px] bg-primary px-6 py-3 text-sm font-semibold text-on-primary transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas-soft"
          >
            Convert now
          </a>
          <a
            href="#table"
            class="inline-flex items-center justify-center rounded-[100px] border border-hairline bg-canvas-soft px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-canvas focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas-soft"
          >
            Table & chart
          </a>
        </div>
      </div>



    </div>
  </div>
</section>
