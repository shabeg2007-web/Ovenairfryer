---
const brand = 'Air Fryer Converter';
const domain = 'ovenairfryer.com';
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur supports-[backdrop-filter]:bg-canvas/60">
  <nav class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-6">
    <a href="/" class="group flex items-center gap-3 focus-visible:outline-none">
      <span
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-hairline text-ink shadow-[0_1px_1px_rgba(0,0,0,0.05)]"
        aria-hidden="true"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M7 7C9 9 11 15 17 17"
            stroke="#171717"
            stroke-width="2"
            stroke-linecap="round"
          />
          <path
            d="M6 12C6 16 9 19 13 19C17 19 20 16 20 12C20 8 17 5 13 5C9 5 6 8 6 12Z"
            stroke="#171717"
            stroke-width="2"
          />
        </svg>
      </span>
      <span class="text-sm font-semibold text-ink">
        {brand}
        <span class="sr-only">Home</span>
      </span>
    </a>

    <div class="hidden items-center gap-6 md:flex" aria-label="Primary navigation">
      <a class="text-sm text-body hover:text-ink transition-colors" href="/#calculator">Calculator</a>
      <a class="text-sm text-body hover:text-ink transition-colors" href="/#table">Conversion table</a>
      <a class="text-sm text-body hover:text-ink transition-colors" href="/#faq">FAQ</a>
      <a class="text-sm text-body hover:text-ink transition-colors" href="/about-us">About Us</a>
      <a class="text-sm text-body hover:text-ink transition-colors" href="/privacy-policy">Privacy Policy</a>
      <a class="text-sm text-body hover:text-ink transition-colors" href="/terms-and-conditions">Terms</a>
      <a class="text-sm text-body hover:text-ink transition-colors" href="/contact-us">Contact</a>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/#calculator"
        class="inline-flex h-9 items-center rounded-md border border-hairline px-3 text-sm font-medium text-ink hover:bg-canvas-soft transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
      >
        Use converter
      </a>
      <a
        href="/#table"
        class="inline-flex h-9 items-center rounded-md bg-primary px-3 text-sm font-semibold text-on-primary hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
      >
        Print chart
      </a>
    </div>
  </nav>
</header>
