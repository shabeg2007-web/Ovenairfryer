---
import { generateConversionTable } from '../../lib/table';

const rows = generateConversionTable(120, 250, 5);

// simple server-rendered searchable table:
// - the search input is client-only, but initial table is fully rendered for SEO.
const minOvenC = 120;
const maxOvenC = 250;

const timeFactor = 0.8;
---

<section id="table" class="bg-canvas-soft">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-mute font-mono">Conversion table</div>
        <h2 class="mt-3 font-display text-display-md tracking-[-0.96px] text-ink">
          Oven → air fryer chart (120°C–250°C)
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-body leading-6">
          Search by oven temperature. Values show recommended air fryer temperature and time reduction using the standard formula.
        </p>
      </div>

      <div class="rounded-2xl border border-hairline bg-canvas p-5">
        <div class="text-xs font-semibold uppercase tracking-wide text-mute font-mono">Standard rule</div>
        <div class="mt-2 text-sm text-body leading-6">
          Air fryer temp ≈ oven temp − 20°C (−25°F)<br />
          Air fryer time ≈ oven time × {timeFactor} (≈ 20% less)
        </div>
      </div>
    </div>

    <div class="mt-10 rounded-2xl border border-hairline bg-canvas shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
      <div class="flex flex-col gap-3 border-b border-hairline bg-canvas-soft p-5 sm:flex-row sm:items-center sm:justify-between">
        <label class="w-full sm:w-auto">
          <span class="text-xs font-semibold uppercase tracking-wide text-mute font-mono">
            Search by oven temp (°C)
          </span>
          <input
            id="table-search"
            type="search"
            inputmode="numeric"
            placeholder={`e.g. 200`}
            class="mt-2 w-full rounded-lg border border-hairline bg-canvas px-3 py-2 text-sm font-semibold text-ink shadow-[0px_1px_1px_rgba(0,0,0,0.02)] focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas-soft sm:w-64"
          />
        </label>

        <div class="flex items-center gap-3">
          <a
            href="#print"
            class="inline-flex items-center justify-center rounded-xl border border-hairline bg-canvas-soft px-4 py-2 text-sm font-semibold text-ink hover:bg-canvas transition-colors focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas-soft"
          >
            Printable chart
          </a>
          <button
            type="button"
            id="clear-table-search"
            class="inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-on-primary hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas-soft"
          >
            Reset search
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-[720px] w-full border-collapse text-left" aria-label="Oven to air fryer conversion table">
          <thead>
            <tr class="bg-canvas-soft">
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Oven (°C)</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Oven (°F)</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Air (°C)</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Air (°F)</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">% time change</th>
            </tr>
          </thead>
          <tbody id="table-body">
            {rows.map((r) => (
              <tr class="border-b border-hairline hover:bg-canvas-soft/60" data-oven-c={r.ovenTempC}>
                <td class="px-4 py-3 text-sm font-semibold text-ink">{r.ovenTempC}</td>
                <td class="px-4 py-3 text-sm font-semibold text-ink">{r.ovenTempF}</td>
                <td class="px-4 py-3 text-sm font-semibold text-ink">{r.airTempC}</td>
                <td class="px-4 py-3 text-sm font-semibold text-ink">{r.airTempF}</td>
                <td class="px-4 py-3 text-sm text-body">{Math.round((1 - r.timeFactor) * 100)}% less</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="p-5 text-xs text-body leading-5">
        Tip: temperatures are rounded for easier cooking. For best results, check doneness early and adjust.
      </div>
    </div>
  </div>

  <section id="print" class="hidden print:block">
    <div class="mx-auto max-w-7xl px-6 pb-16">
      <h3 class="text-lg font-display tracking-[-0.6px] text-ink">Oven to Air Fryer Conversion Chart</h3>
      <p class="mt-2 text-sm text-body">
        Standard rule: Air temp ≈ oven temp − 20°C (−25°F). Air time ≈ oven time × 0.8 (≈ 20% less).
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="min-w-[720px] w-full border-collapse" aria-label="Printable conversion chart">
          <thead>
            <tr class="bg-canvas-soft">
              <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-mute font-mono border border-hairline">Oven (°C)</th>
              <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-mute font-mono border border-hairline">Oven (°F)</th>
              <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-mute font-mono border border-hairline">Air (°C)</th>
              <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-mute font-mono border border-hairline">Air (°F)</th>
              <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-mute font-mono border border-hairline">Time change</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="px-3 py-2 text-sm font-semibold text-ink border border-hairline">{r.ovenTempC}</td>
                <td class="px-3 py-2 text-sm font-semibold text-ink border border-hairline">{r.ovenTempF}</td>
                <td class="px-3 py-2 text-sm font-semibold text-ink border border-hairline">{r.airTempC}</td>
                <td class="px-3 py-2 text-sm font-semibold text-ink border border-hairline">{r.airTempF}</td>
                <td class="px-3 py-2 text-sm text-body border border-hairline">{Math.round((1 - r.timeFactor) * 100)}% less</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 text-xs text-body">
        Generated for Air Fryer Converter. Always verify doneness and adjust for your fryer and batch size.
      </div>
    </div>
  </section>

  <script is:inline>
    const searchInput = document.getElementById('table-search');
    const clearBtn = document.getElementById('clear-table-search');
    const tbody = document.getElementById('table-body');
    const rows = tbody ? Array.from(tbody.querySelectorAll('tr')) : [];

    function applySearch(query) {
      if (!query) {
        for (const r of rows) r.style.display = '';
        return;
      }
      const q = String(query).trim();
      for (const r of rows) {
        const v = r.getAttribute('data-oven-c');
        r.style.display = v === q ? '' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => applySearch(e.target.value));
    }
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        applySearch('');
        if (searchInput) searchInput.focus();
      });
    }
  </script>

  <style>
    @media print {
      /* Hide everything by default; show the printable chart section */
      body * {
        visibility: hidden;
      }
      #print, #print * {
        visibility: visible;
      }
      /* Make print readable */
      #print {
        display: block !important;
      }
      header, footer, nav, #calculator, #tips, #faq {
        display: none !important;
      }
    }
  </style>
</section>
