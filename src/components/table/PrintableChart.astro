---
import { generateConversionTable } from '../../lib/table';

const rows = generateConversionTable(120, 250, 5);
---

<section id="printable-chart" class="bg-canvas-soft">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
    <div class="flex items-end justify-between gap-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-mute font-mono">Printable chart</div>
        <h2 class="mt-3 font-display text-display-md tracking-[-0.96px] text-ink">Take the oven-to-air-fryer chart offline</h2>
        <p class="mt-3 max-w-2xl text-sm text-body leading-6">
          Print-friendly layout with the same standard conversion rule the calculator uses.
        </p>
      </div>
      <div class="hidden md:block rounded-2xl border border-hairline bg-canvas p-5">
        <div class="text-xs font-semibold uppercase tracking-wide text-mute font-mono">Pro tip</div>
        <div class="mt-2 text-sm text-body leading-6">Check doneness early—air fryers vary by model.</div>
      </div>
    </div>

    <div class="mt-10 overflow-x-auto rounded-2xl border border-hairline bg-canvas shadow-[0px_1px_1px_rgba(0,0,0,0.03)] print:shadow-none">
      <table class="min-w-[720px] w-full border-collapse">
        <thead>
          <tr class="bg-canvas-soft">
            <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Oven (°C)</th>
            <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Oven (°F)</th>
            <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Air (°C)</th>
            <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">Air (°F)</th>
            <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-mute font-mono border-b border-hairline">% time change</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-hairline">
              <td class="px-4 py-3 text-sm font-semibold text-ink">{r.ovenTempC}</td>
              <td class="px-4 py-3 text-sm font-semibold text-ink">{r.ovenTempF}</td>
              <td class="px-4 py-3 text-sm font-semibold text-ink">{r.airTempC}</td>
              <td class="px-4 py-3 text-sm font-semibold text-ink">{r.airTempF}</td>
              <td class="px-4 py-3 text-sm text-body">{Math.round((1 - r.timeFactor) * 100)}% less</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-xs text-body leading-5">
        Generated by Air Fryer Converter. Always verify doneness and adjust for your fryer and batch size.
      </div>
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-[100px] bg-primary px-6 py-3 text-sm font-semibold text-on-primary hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas-soft"
        onclick="window.print()"
      >
        Print chart
      </button>
    </div>
  </div>
</section>
