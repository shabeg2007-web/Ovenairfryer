---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

type Props = {
	title?: string;
	description?: string;
	canonical?: string;
};

const {
	title = 'Oven to Air Fryer Converter (Instant Temperature & Time Calculator)',
	description =
		'Convert oven temperatures and cooking times into air fryer settings instantly. Free oven-to-air-fryer conversion calculator, charts, and cooking guides.',
	canonical = 'https://airfryerconverter.com/',
} = Astro.props;

const ogImageUrl = new URL('/og-image.png', canonical).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="ovencalc" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta name="generator" content={Astro.generator} />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-N8ZZJ2P8RB"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];

		  function gtag(...args) {
		    window.dataLayer.push(args);
		  }

		  gtag('js', new Date());
		  gtag('config', 'G-N8ZZJ2P8RB');
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Oven to Air Fryer Converter" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<meta name="theme-color" content="#171717" />

		<script type="application/ld+json" set:html={JSON.stringify(
			{
				'@context': 'https://schema.org',
				'@type': 'WebApplication',
				name: title,
				description: description,
				url: canonical,
				applicationCategory: 'Food & Drink',
				operatingSystem: 'All',
				browserRequirements: 'Requires a modern web browser.',
			},
			null,
			2
		)}></script>
	</head>

	<body>
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
