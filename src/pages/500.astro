---
import Layout from '../layouts/Layout.astro';

const title = '500 Server Error | Oven to Air Fryer Converter';
const description =
	'An unexpected server error occurred. Return to the Oven to Air Fryer Conversion Calculator.';
const canonical = 'https://airfryerconverter.com/500';
---

<Layout title={title} description={description} canonical={canonical}>
	<main class="flex min-h-[calc(100vh-4rem)] w-full items-center justify-center px-6 py-12">
		<div class="w-full max-w-lg">
			<div class="rounded-2xl border border-hairline bg-canvas-soft/60 p-8 shadow-[0_1px_2px_rgba(0,0,0,0.04)] backdrop-blur">
				<div class="text-ink">
					<h1 class="text-display-lg font-display tracking-[-1.1px]">500</h1>
					<h2 class="mt-2 text-display-md font-display tracking-[-0.96px]">Something Went Wrong</h2>
					<p class="mt-3 text-sm text-body leading-6">
						An unexpected error occurred while loading this page. Please try again later.
					</p>

					<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
						<a
							href="/"
							class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-on-primary hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
						>
							Return Home
						</a>
					</div>
				</div>
			</div>

			<p class="mt-6 text-center text-xs text-mute">
				If the issue persists, return to the calculator and try again.
			</p>
		</div>
	</main>
</Layout>
