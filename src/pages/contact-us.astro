---
import Layout from '../layouts/Layout.astro';

const title = 'Contact Us';
const description =
	'Contact Air Fryer Converter. Report bugs, suggest improvements, and request content corrections or business inquiries.';
const canonical = 'https://airfryerconverter.com/contact-us/';
---

<Layout title={title} description={description} canonical={canonical}>
	<main class="mx-auto max-w-7xl px-6 py-10 md:py-14">
		<section class="bg-canvas-soft rounded-3xl border border-hairline p-6 md:p-10">
			<h1 class="font-display text-display-xl tracking-[-2.4px] text-ink">Contact Us</h1>

			<p class="mt-4 max-w-3xl text-sm text-body leading-7">
				Have a question about using the oven to air fryer conversion calculator, want to report a bug, or think a guide could be clearer?
				Send us a note. We welcome feedback to help improve the tool and the content people rely on for consistent results.
			</p>

			<div class="mt-6 max-w-3xl">
				<h2 class="font-display text-display-md tracking-[-0.96px] text-ink">Email</h2>
				<p class="mt-3 text-sm text-body leading-7">
					For all inquiries, email us at:
					<a class="underline font-semibold" href="mailto:routevanii@gmail.com">routevanii@gmail.com</a>
				</p>
			</div>

			<div class="mt-8">
				<h2 class="font-display text-display-md tracking-[-0.96px] text-ink">Reasons to contact us</h2>
				<ul class="mt-4 space-y-2 max-w-3xl text-sm text-body leading-7 list-disc pl-5">
					<li>Report bugs</li>
					<li>Suggest improvements</li>
					<li>Business inquiries</li>
					<li>Content corrections</li>
				</ul>
			</div>

			<div class="mt-8 max-w-3xl rounded-2xl border border-hairline bg-canvas p-6">
				<h3 class="font-display text-display-sm tracking-[-0.6px] text-ink">Simple Contact Card</h3>
				<p class="mt-3 text-sm text-body leading-6">
					No form is required. Email us directly and include details (device, browser, and the recipe or values) so we can help faster.
				</p>
				<div class="mt-4 text-sm text-body leading-6">
					<strong>Email:</strong> <a class="underline" href="mailto:routevanii@gmail.com">routevanii@gmail.com</a>
				</div>
			</div>
		</section>
	</main>

	<section class="mx-auto max-w-7xl px-6 pb-12">
		<div class="mt-6 text-sm text-body">
			Looking for conversion guidance? Visit <a class="underline" href="/">the oven to air fryer conversion calculator</a>.
		</div>
	</section>
</Layout>
