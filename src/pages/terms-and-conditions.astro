---
import Layout from '../layouts/Layout.astro';

const title = 'Terms & Conditions';
const description =
	'Read our terms and conditions: acceptance of terms, tool disclaimer, no warranty, limitation of liability, intellectual property, and changes.';
const canonical = 'https://ovenairfryer.com/terms-and-conditions/';
---

<Layout title={title} description={description} canonical={canonical}>
	<main class="mx-auto max-w-7xl px-6 py-10 md:py-14">
		<section class="bg-canvas-soft rounded-3xl border border-hairline p-6 md:p-10">
			<h1 class="font-display text-display-xl tracking-[-2.4px] text-ink">Terms &amp; Conditions</h1>

			<p class="mt-4 max-w-3xl text-sm text-body leading-7">
				These Terms &amp; Conditions (“Terms”) govern your use of Air Fryer Converter, including the oven to air fryer conversion
				calculator, conversion charts, and related content (“Tool”).
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">Acceptance of Terms</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				By accessing or using the Tool, you agree to these Terms. If you do not agree, you should not use the Tool.
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">Tool Disclaimer</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				The Tool provides general guidance for oven to air fryer conversion. Results are estimates and may vary depending on food
				type, recipe, batch size, fryer model, and other factors. Always verify doneness and use safe cooking practices.
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">No Warranty</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				We provide the Tool “as is” and “as available.” We disclaim all warranties, express or implied, including implied warranties
				of merchantability, fitness for a particular purpose, and non-infringement.
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">Limitation of Liability</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				To the maximum extent permitted by law, we shall not be liable for any indirect, incidental, special, consequential, or punitive
				damages, or any loss of profits, revenue, data, or goodwill, arising out of or relating to your use of the Tool.
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">Intellectual Property</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				The Tool, including its content, design elements, and intellectual property, is protected by applicable laws. You may not
				reproduce, distribute, or create derivative works without our permission.
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">User Responsibilities</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				You are responsible for how you use the Tool. You should follow safe food handling and cooking practices, and you should not
				rely on the Tool as the only source of guidance.
			</p>

			<h2 class="mt-8 font-display text-display-md tracking-[-0.96px] text-ink">Changes to Terms</h2>
			<p class="mt-3 max-w-3xl text-sm text-body leading-7">
				We may update these Terms from time to time. Continued use of the Tool after changes become effective constitutes acceptance of
				the updated Terms.
			</p>

			<div class="mt-8 max-w-3xl rounded-2xl border border-hairline bg-canvas-soft p-5">
				<p class="text-sm text-body leading-6">
					<strong>Disclaimer:</strong> These Terms are provided for transparency and may not constitute legal advice.
				</p>
			</div>
		</section>
	</main>

	<section class="mx-auto max-w-7xl px-6 pb-12">
		<div class="mt-6 text-sm text-body">
			Questions? Visit <a class="underline" href="/contact-us">Contact Us</a>.
		</div>
	</section>
</Layout>
